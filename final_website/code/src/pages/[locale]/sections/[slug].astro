---
import Site from '../../../layouts/Site.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPost } from '../../../lib/posts';
import { pageCtx } from '../../../lib/ctx';
import { sections } from '../../../lib/sections';
const { locale, unknown, ui, origin } = pageCtx(Astro);
const section = sections.find(item => item.slug === Astro.params.slug);
if (unknown || !section) Astro.response.status = 404;
const s = section ?? sections[0];
const items = s.posts.map(slug => getPost(slug)).filter((p): p is NonNullable<typeof p> => !!p);
---
<Site locale={locale} title={s.title} current={`section-${s.slug}`} description={s.focus} noindex={!section || unknown} siteUrl={origin}>
  <div class="wrap page">
    <header class="section-intro">
      <h1 class="section-heading"><span lang="en">{s.title}</span>{s.exclusive && <span class="exclusive-badge" lang="en">Exclusive</span>}</h1>
      <p class="lede" lang="en">{s.focus}</p>
    </header>
    <h2 class="section-posts-title" lang="en">Latest in {s.title}</h2>
    {items.length > 0
      ? <div class="grid posts catalog-cards">{items.map(post => <PostCard post={post} locale={locale} ui={ui} />)}</div>
      : <p class="muted" lang="en">No stories have been published in this section yet. New reporting will appear here first.</p>}
    <section class="section-body" lang="en">
      <h2>{s.insightTitle}</h2>
      <p>{s.insight}</p>
      <h2>Sample article angles</h2>
      <ul>{s.angles.map(angle => <li>{angle}</li>)}</ul>
      {s.exclusive && <p class="muted small">Exclusive to Blink, Know, Repeat: reporting you will not find on other portals.</p>}
    </section>
  </div>
</Site>
